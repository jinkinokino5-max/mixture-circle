{
  "name": "studio-pulse-iii",
  "version": "6.0.0",
  "private": true,
  "description": "STUDIO PULSE III — ROLE × INSTRUMENT × VARIATION で音楽を積み上げるアプリ",
  "scripts": {
    "check": "node tools/check-music.js && node tools/check-engine.js",
    "check:music": "node tools/check-music.js",
    "check:engine": "node tools/check-engine.js",
    "measure": "node tools/measure-loudness.mjs",
    "trim": "node tools/apply-trim.mjs",
    "samples": "node fetch-samples.js",
    "start": "node server.js 8771",
    "gain": "node tools/apply-gain.mjs",
    "balance": "npm run measure && npm run gain && npm run measure && npm run trim"
  },
  "devDependencies": {
    "node-web-audio-api": "^2.2.0"
  }
}
