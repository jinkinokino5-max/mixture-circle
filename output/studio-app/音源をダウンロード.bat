@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================
echo  ミクスチャー・サークル STUDIO  本格音源のダウンロード
echo ------------------------------------------------------------
echo  最初に1度だけ実行してください（2回目以降は差分だけ取得）。
echo  インターネット接続が必要です。全部で 10MB 前後です。
echo ============================================================
echo.

where node >nul 2>nul
if not %errorlevel%==0 (
  echo Node.js が見つかりませんでした。
  echo   https://nodejs.org/ からインストールしてから、もう一度実行してください。
  echo.
  echo ※ダウンロードしなくても遊べますが、全パートが合成音になります。
  pause
  goto :eof
)

node fetch-samples.js
echo.
echo 終わりました。「はじめる.bat」でアプリを開いてください。
pause
